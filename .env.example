# Copy this file to .env.local and fill in real values for local dev.
# In production, set these in the Vercel project dashboard instead.

# OpenAI
OPENAI_API_KEY=

# OpenSearch (Bonsai.io or AWS OpenSearch Serverless)
# OPENSEARCH_URL is the cluster host without credentials in the URL.
# Username and password live in separate vars so they do not leak into logs.
OPENSEARCH_URL=https://your-cluster.us-east-1.bonsaisearch.net
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# Mapbox public token (exposed to the browser)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Replicate (image embeddings, ingestion only, not needed in Vercel)
REPLICATE_API_TOKEN=

# Unsplash (photos, ingestion only, not needed in Vercel)
UNSPLASH_ACCESS_KEY=

# App
NEXT_PUBLIC_APP_URL=https://home-finder-claw.vercel.app
